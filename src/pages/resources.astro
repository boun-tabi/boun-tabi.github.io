---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Resources - TABILAB">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-primary mb-12 text-center">Resources</h1>

    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a
          href="https://tulap.cmpe.boun.edu.tr/home"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow"
        >
          <div class="bg-gray-100">
            <img
              src={`${import.meta.env.BASE_URL}images/tulap.png`}
              alt="TULAP - Turkish Language Processing Platform"
              class="w-full h-auto"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-primary mb-2">TULAP</h3>
            <p class="text-gray-700">Turkish Language Processing Platform - A comprehensive resource for Turkish NLP tools and datasets.</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
