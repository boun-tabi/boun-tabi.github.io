---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

// Get featured papers
const papers = await getCollection('papers', (paper) => paper.data.featured === true);
papers.sort((a, b) => b.data.year - a.data.year);
const featuredPapers = papers.slice(0, 3);

// Get featured projects
const projects = await getCollection('projects', (project) => project.data.featured === true);
projects.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
const featuredProjects = projects.slice(0, 3);

// Get latest news
const news = await getCollection('news');
news.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestNews = news.slice(0, 3);

// Format date function
function formatDate(date) {
  return format(new Date(date), 'MMMM d, yyyy');
}
---

<MainLayout title="TABILAB - Text Analytics and BIoInformatics Lab">
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl font-bold mb-4">TABILAB</h1>
        <p class="text-2xl mb-6">Text Analytics and Bioinformatics Lab</p>

        <p class="text-xl mb-10">
          We develop machine learning methods for understanding both human language and biological systems.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/projects"
            class="bg-white text-primary font-bold py-3 px-6 rounded-lg hover:bg-gray-100 transition-colors"
          >
            Our Projects
          </a>
          <a
            href="/papers"
            class="bg-transparent border-2 border-white text-white font-bold py-3 px-6 rounded-lg hover:bg-white/10 transition-colors"
          >
            Research Papers
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold text-primary mb-8 text-center">
          Welcome to TABILab
        </h2>

        <p class="text-lg text-gray-800 text-center max-w-3xl mx-auto mb-10 leading-relaxed">
          TABILab is a research group developing machine learning methods for both language and biological
          data. Our projects span natural language processing and bioinformatics.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {/* NLP column */}
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary/10">
              <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="28" 
                    height="28" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    strokeWidth="2" 
                    strokeLinecap="round" 
                    strokeLinejoin="round"
                  >
                    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                    <path d="M8 12h.01" />
                    <path d="M12 12h.01" />
                    <path d="M16 12h.01" />
                  </svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-primary mb-2">
                Natural Language Processing (NLP)
              </h3>
              <p class="text-gray-800 leading-relaxed">
                We study linguistic structure, information extraction, and language modeling,
                with a particular focus on Turkish and other low-resource languages.
              </p>
            </div>
          </div>

          {/* Bioinformatics column */}
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary/10">
              <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="28" 
                    height="28" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    strokeWidth="2" 
                    strokeLinecap="round" 
                    strokeLinejoin="round"
                  >
                    <path d="M2 15c6.667-6 13.333 0 20-6" />
                    <path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993" />
                    <path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993" />
                    <path d="M17 6l-2.5-2.5" />
                    <path d="M14 8l-1-1" />
                    <path d="M7 18l2.5 2.5" />
                    <path d="M3.5 14.5l-1 1" />
                    <path d="M20 9l-1 1" />
                    <path d="M14.5 9.5L14 10" />
                    <path d="M9.5 14.5L10 14" />
                  </svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-primary mb-2">
                Bioinformatics
              </h3>
              <p class="text-gray-800 leading-relaxed">
                We build computational representations of proteins, genes, and compounds to study
                interactions, annotate function, and support molecular design, exploring new ways
                to understand the “language of life” embedded in biological sequences.
              </p>
            </div>
          </div>
        </div>

        <p class="text-lg text-gray-800 text-center mt-10 leading-relaxed">
          Our work is grounded in interdisciplinary collaboration and high-quality datasets that enable
          robust, theory-informed models across both domains.
        </p>
      </div>
    </div>
  </section>


